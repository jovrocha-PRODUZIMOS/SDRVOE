      "id": "trigger-schedule",
      "name": "Verificar Follow-ups (A cada hora)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [80, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT session_id, phone_number, customer_name, last_message_at, follow_up_stage, flight_origin, flight_destination, travel_date, quote_value\nFROM conversations\nWHERE status = 'pending'\n  AND last_message_at < NOW() - INTERVAL '2 hours'\n  AND (follow_up_sent_at IS NULL OR follow_up_sent_at < NOW() - INTERVAL '24 hours')\n  AND follow_up_count < 3\nORDER BY last_message_at ASC\nLIMIT 50;",
        "options": {}
      },
      "id": "db-buscar-pendentes",
      "name": "Buscar Conversas Pendentes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [300, 300],
      "credentials": {
        "postgres": {
          "id": "SEU_CREDENTIAL_POSTGRES_ID",
          "name": "Postgres - SDRVOE"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-results",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
