{
  "name": "Follow-up Atendimento - Passagens Aéreas",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "Verificar Follow-ups (A cada hora)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [80, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT session_id, phone_number, customer_name, last_message_at, follow_up_stage, flight_origin, flight_destination, travel_date, quote_value FROM conversations WHERE status = 'pending' AND last_message_at < NOW() - INTERVAL '2 hours' AND (follow_up_sent_at IS NULL OR follow_up_sent_at < NOW() - INTERVAL '24 hours') AND follow_up_count < 3 ORDER BY last_message_at ASC LIMIT 50;",
        "options": {}
      },
      "id": "db-buscar-pendentes",
      "name": "Buscar Conversas Pendentes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [300, 300],
      "credentials": {
        "postgres": {
          "id": "SEU_CREDENTIAL_POSTGRES_ID",
          "name": "Postgres - SDRVOE"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversations SET status = 'closed', closed_reason = 'follow_up_limit_reached', updated_at = NOW() WHERE session_id IN (SELECT session_id FROM conversations WHERE status = 'pending' AND follow_up_count >= 3 AND last_message_at < NOW() - INTERVAL '72 hours');",
        "options": {}
      },
      "id": "db-fechar-antigas",
      "name": "Fechar Conversas Sem Resposta",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [300, 520],
      "credentials": {
        "postgres": {
          "id": "SEU_CREDENTIAL_POSTGRES_ID",
          "name": "Postgres - SDRVOE"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-results",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-tem-pendentes",
      "name": "Tem conversas pendentes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "jsCode": "console.log('[Follow-up] Nenhuma conversa pendente encontrada.');\nreturn [];"
      },
      "id": "no-op-sem-pendentes",
      "name": "Nenhum follow-up necessário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 500]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-conversas",
      "name": "Processar cada conversa",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [740, 220]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "rule-quote",
                    "leftValue": "={{ $json.follow_up_stage }}",
                    "rightValue": "quote_sent",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "cotacao_enviada"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "rule-initial",
                    "leftValue": "={{ $json.follow_up_stage }}",
                    "rightValue": "initial_contact",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "contato_inicial"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "rule-abandoned",
                    "leftValue": "={{ $json.follow_up_stage }}",
                    "rightValue": "booking_abandoned",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reserva_abandonada"
            }
          ]
        },
        "fallbackOutput": "extra",
        "options": {}
      },
      "id": "check-estagio",
      "name": "Qual estagio do follow-up?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [960, 220]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst followUpCount = item.follow_up_count || 0;\nconst msgs = [\n  'Ola ' + item.customer_name + '! Vi que voce estava pesquisando passagens de ' + item.flight_origin + ' para ' + item.flight_destination + '. Sua cotacao ainda esta disponivel! Quer que eu verifique a disponibilidade atualizada?',\n  'Oi ' + item.customer_name + '! Tudo bem? Nao quero que voce perca essa oportunidade de viagem para ' + item.flight_destination + '. Os precos podem mudar - posso confirmar sua reserva agora?',\n  item.customer_name + ', ultima oportunidade! Sua cotacao para ' + item.flight_destination + (item.travel_date ? ' em ' + item.travel_date : '') + ' esta prestes a expirar. Posso ajudar a finalizar sua compra?'\n];\nreturn [{ json: { ...item, follow_up_message: msgs[Math.min(followUpCount, msgs.length - 1)], follow_up_type: 'quote_followup', novo_follow_up_count: followUpCount + 1 } }];"
      },
      "id": "msg-cotacao",
      "name": "Mensagem - Cotacao Pendente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 60]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst followUpCount = item.follow_up_count || 0;\nconst msgs = [\n  'Ola ' + item.customer_name + '! Somos da SDRVOE Passagens. Voce entrou em contato conosco e gostaríamos de te ajudar. Como posso te ajudar hoje?',\n  'Oi ' + item.customer_name + '! Estamos aqui para ajudar com suas passagens aereas. Voce tem alguma duvida ou quer fazer uma cotacao?',\n  item.customer_name + ', estamos disponiveis para voce! Se precisar de passagens, cotacoes ou qualquer ajuda com viagens, e so chamar!'\n];\nreturn [{ json: { ...item, follow_up_message: msgs[Math.min(followUpCount, msgs.length - 1)], follow_up_type: 'initial_contact_followup', novo_follow_up_count: followUpCount + 1 } }];"
      },
      "id": "msg-contato-inicial",
      "name": "Mensagem - Contato Inicial",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 240]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst followUpCount = item.follow_up_count || 0;\nconst msgs = [\n  'Oi ' + item.customer_name + '! Notei que voce estava quase finalizando sua reserva para ' + item.flight_destination + '. Aconteceu algum problema? Posso ajudar a concluir sua compra!',\n  item.customer_name + ', ainda da tempo! Sua reserva para ' + item.flight_destination + (item.travel_date ? ' em ' + item.travel_date : '') + ' esta aguardando. Quer que eu retome o processo para voce?',\n  'Ultima chance, ' + item.customer_name + '! Finalize sua passagem para ' + item.flight_destination + ' antes que os assentos esgotem. Me chame agora!'\n];\nreturn [{ json: { ...item, follow_up_message: msgs[Math.min(followUpCount, msgs.length - 1)], follow_up_type: 'abandoned_booking_followup', novo_follow_up_count: followUpCount + 1 } }];"
      },
      "id": "msg-reserva-abandonada",
      "name": "Mensagem - Reserva Abandonada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 420]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nreturn [{ json: { ...item, follow_up_message: 'Ola ' + item.customer_name + '! Ainda podemos ajuda-lo com suas passagens aereas. Como posso te ajudar?', follow_up_type: 'generic_followup', novo_follow_up_count: (item.follow_up_count || 0) + 1 } }];"
      },
      "id": "msg-generica",
      "name": "Mensagem - Generica",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 600]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.follow_up_message }}",
        "options": {
          "systemMessage": "Voce e um especialista em reescrever mensagens de follow-up para uma empresa de passagens aereas chamada SDRVOE. Humanize a mensagem recebida tornando-a mais natural e calorosa, sem inventar informacoes. Use linguagem brasileira informal mas profissional. Maximo 3 paragrafos curtos. Retorne APENAS a mensagem, sem explicacoes."
        }
      },
      "id": "ai-humaniza",
      "name": "IA - Humaniza Follow-up",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [1440, 320],
      "credentials": {
        "openAiApi": {
          "id": "SEU_CREDENTIAL_OPENAI_ID",
          "name": "OpenAI - SDRVOE"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst humanized = item.text || item.content || item.follow_up_message;\nreturn [{ json: { ...item, mensagem_final: humanized } }];"
      },
      "id": "extrai-mensagem-humanizada",
      "name": "Extrair Mensagem Humanizada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1660, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{$vars.WHATSAPP_PHONE_NUMBER_ID}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone_number}}\",\"type\":\"text\",\"text\":{\"preview_url\":false,\"body\":\"{{$json.mensagem_final}}\"}}",
        "options": {}
      },
      "id": "whatsapp-send",
      "name": "Enviar Follow-up WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1880, 320],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SEU_CREDENTIAL_WHATSAPP_ID",
          "name": "WhatsApp API - SDRVOE"
        }
      }
    },
