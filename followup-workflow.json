      "id": "check-enviou",
      "name": "Mensagem enviada com sucesso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2320, 340]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversations\nSET \n  follow_up_sent_at = NOW(),\n  follow_up_count = {{ $json.novo_follow_up_count }},\n  last_follow_up_type = '{{ $json.follow_up_type }}',\n  updated_at = NOW()\nWHERE session_id = '{{ $json.session_id }}';",
        "options": {}
      },
      "id": "db-atualiza-sucesso",
      "name": "Atualizar DB - Follow-up Enviado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2540, 220],
      "credentials": {
        "postgres": {
          "id": "SEU_CREDENTIAL_POSTGRES_ID",
          "name": "Postgres - SDRVOE"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversations\nSET \n  follow_up_error = '{{ $json.error?.message || \"Falha ao enviar\" }}',\n  follow_up_error_at = NOW(),\n  updated_at = NOW()\nWHERE session_id = '{{ $json.session_id }}';",
        "options": {}
      },
      "id": "db-atualiza-erro",
      "name": "Registrar Erro de Envio",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2540, 460],
      "credentials": {
        "postgres": {
          "id": "SEU_CREDENTIAL_POSTGRES_ID",
          "name": "Postgres - SDRVOE"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversations\nSET \n  status = 'closed',\n  closed_reason = 'follow_up_limit_reached',\n  updated_at = NOW()\nWHERE session_id IN (\n  SELECT session_id FROM conversations\n  WHERE status = 'pending'\n    AND follow_up_count >= 3\n    AND last_message_at < NOW() - INTERVAL '72 hours'\n);",
        "options": {}
      },
      "id": "db-fechar-antigas",
      "name": "Fechar Conversas Sem Resposta (3+ follow-ups)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [300, 520],
      "credentials": {
        "postgres": {
          "id": "SEU_CREDENTIAL_POSTGRES_ID",
          "name": "Postgres - SDRVOE"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Relatório de follow-ups processados\nconst items = $input.all();\nconst total = items.length;\nconst sucessos = items.filter(i => i.json.messages?.[0]?.id).length;\nconst erros = total - sucessos;\n\nconsole.log(`[Follow-up] Processados: ${total} | Enviados: ${sucessos} | Erros: ${erros}`);\n\nreturn [{ json: { total, sucessos, erros, timestamp: new Date().toISOString() } }];"
      },
      "id": "relatorio-final",
      "name": "Relatório de Execução",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2760, 340]
    }
