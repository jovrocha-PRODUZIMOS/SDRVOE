          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-tem-pendentes",
      "name": "Tem conversas pendentes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "jsCode": "// Sem pendências — apenas loga e encerra\nconsole.log('[Follow-up] Nenhuma conversa pendente encontrada.');\nreturn [];"
      },
      "id": "no-op-sem-pendentes",
      "name": "Nenhum follow-up necessário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 500]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-conversas",
      "name": "Processar cada conversa",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [740, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "stage-check",
              "leftValue": "={{ $json.follow_up_stage }}",
              "rightValue": "quote_sent",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-estagio",
      "name": "Qual estágio do follow-up?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [960, 220],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": false, "leftValue": "", "typeValidation": "loose"},
                "conditions": [
                  {
                    "leftValue": "={{ $json.follow_up_stage }}",
                    "rightValue": "quote_sent",
                    "operator": {"type": "string", "operation": "equals"}
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "cotacao_enviada"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false, "leftValue": "", "typeValidation": "loose"},
                "conditions": [
                  {
                    "leftValue": "={{ $json.follow_up_stage }}",
                    "rightValue": "initial_contact",
                    "operator": {"type": "string", "operation": "equals"}
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "contato_inicial"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false, "leftValue": "", "typeValidation": "loose"},
                "conditions": [
                  {
                    "leftValue": "={{ $json.follow_up_stage }}",
                    "rightValue": "booking_abandoned",
                    "operator": {"type": "string", "operation": "equals"}
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reserva_abandonada"
            }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
      "parameters": {
        "jsCode": "// Follow-up para cotação enviada mas não confirmada\nconst item = $input.item.json;\nconst followUpCount = item.follow_up_count || 0;\n\nconst mensagens = [\n  `Olá ${item.customer_name}! 😊 Vi que você estava pesquisando passagens de *${item.flight_origin}* para *${item.flight_destination}*. Sua cotação ainda está disponível! Quer que eu verifique a disponibilidade atualizada?`,\n  `Oi ${item.customer_name}! Tudo bem? 🛫 Não quero que você perca essa oportunidade de viagem para *${item.flight_destination}*. Os preços podem mudar — posso confirmar sua reserva agora?`,\n  `${item.customer_name}, última oportunidade! ✈️ Sua cotação para *${item.flight_destination}* ${item.travel_date ? `em *${item.travel_date}*` : ''} está prestes a expirar. Posso ajudar a finalizar sua compra?`\n];\n\nconst mensagem = mensagens[Math.min(followUpCount, mensagens.length - 1)];\n\nreturn [{\n  json: {\n    ...item,\n    follow_up_message: mensagem,\n    follow_up_type: 'quote_followup',\n    novo_follow_up_count: followUpCount + 1\n  }\n}];"
      },
      "id": "msg-cotacao",
      "name": "Montar Mensagem - Cotação Pendente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 100]
    },
    {
      "parameters": {
        "jsCode": "// Follow-up para contato inicial sem resposta\nconst item = $input.item.json;\nconst followUpCount = item.follow_up_count || 0;\n\nconst mensagens = [\n  `Olá ${item.customer_name}! 👋 Somos da SDRVOE Passagens. Você entrou em contato conosco e gostaríamos de ajudá-lo(a). Como posso te ajudar hoje?`,\n  `Oi ${item.customer_name}! Estamos aqui para ajudar com suas passagens aéreas ✈️. Você tem alguma dúvida ou quer fazer uma cotação?`,\n  `${item.customer_name}, estamos disponíveis para você! 😊 Se precisar de passagens, cotações ou qualquer ajuda com viagens, é só chamar!`\n];\n\nconst mensagem = mensagens[Math.min(followUpCount, mensagens.length - 1)];\n\nreturn [{\n  json: {\n    ...item,\n    follow_up_message: mensagem,\n    follow_up_type: 'initial_contact_followup',\n    novo_follow_up_count: followUpCount + 1\n  }\n}];"
      },
      "id": "msg-contato-inicial",
      "name": "Montar Mensagem - Contato Inicial",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 260]
    },
    {
      "parameters": {
        "jsCode": "// Follow-up para reserva abandonada no checkout\nconst item = $input.item.json;\nconst followUpCount = item.follow_up_count || 0;\n\nconst mensagens = [\n  `Oi ${item.customer_name}! 🎫 Notei que você estava quase finalizando sua reserva para *${item.flight_destination}*. Aconteceu algum problema? Posso ajudar a concluir sua compra!`,\n  `${item.customer_name}, ainda dá tempo! ⏰ Sua reserva para *${item.flight_destination}* ${item.travel_date ? `em *${item.travel_date}*` : ''} está aguardando. Quer que eu retome o processo para você?`,\n  `Última chance, ${item.customer_name}! 🚨 Finalize sua passagem para *${item.flight_destination}* antes que os assentos esgotem. Clique aqui para continuar ou me chame agora!`\n];\n\nconst mensagem = mensagens[Math.min(followUpCount, mensagens.length - 1)];\n\nreturn [{\n  json: {\n    ...item,\n    follow_up_message: mensagem,\n    follow_up_type: 'abandoned_booking_followup',\n    novo_follow_up_count: followUpCount + 1\n  }\n}];"
      },
      "id": "msg-reserva-abandonada",
      "name": "Montar Mensagem - Reserva Abandonada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 420]
    },
    {
      "parameters": {
        "jsCode": "// Mensagem genérica para outros estágios\nconst item = $input.item.json;\n\nreturn [{\n  json: {\n    ...item,\n    follow_up_message: `Olá ${item.customer_name}! 😊 Ainda podemos ajudá-lo(a) com suas passagens aéreas. Como posso te ajudar?`,\n    follow_up_type: 'generic_followup',\n    novo_follow_up_count: (item.follow_up_count || 0) + 1\n  }\n}];"
      },
      "id": "msg-generica",
      "name": "Montar Mensagem - Genérica",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 580]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "merge-mensagens",
      "name": "Unificar mensagens",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1440, 340]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Você é um assistente especialista em reescrever mensagens de follow-up para uma empresa de passagens aéreas chamada SDRVOE. \nSua tarefa é humanizar a mensagem recebida, tornando-a mais natural, calorosa e persuasiva, sem perder as informações importantes.\nRegras:\n- Mantenha o nome do cliente\n- Mantenha os dados de voo (origem, destino, data) se presentes\n- Use linguagem brasileira informal mas profissional\n- Máximo 3 parágrafos curtos\n- Não use emojis em excesso (máximo 2)\n- Nunca invente informações que não estejam na mensagem original\nRetorne APENAS a mensagem humanizada, sem explicações."
            },
            {
              "role": "user",
              "content": "={{ $json.follow_up_message }}"
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 300
        }
      },
      "id": "ai-humaniza",
      "name": "IA - Humaniza Follow-up",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [1660, 340],
      "credentials": {
        "openAiApi": {
          "id": "SEU_CREDENTIAL_OPENAI_ID",
          "name": "OpenAI - SDRVOE"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Verifica se a mensagem humanizada foi gerada com sucesso\nconst item = $input.item.json;\nconst mensagemHumanizada = item.message?.content || item.choices?.[0]?.message?.content || item.follow_up_message;\n\nreturn [{\n  json: {\n    ...item,\n    mensagem_final: mensagemHumanizada\n  }\n}];"
      },
      "id": "extrai-mensagem-humanizada",
      "name": "Extrair Mensagem Humanizada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1880, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $vars.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phone_number }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"preview_url\": false,\n    \"body\": \"{{ $json.mensagem_final }}\"\n  }\n}",
        "options": {}
      },
      "id": "whatsapp-send",
      "name": "Enviar Follow-up WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2100, 340],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SEU_CREDENTIAL_WHATSAPP_ID",
          "name": "WhatsApp API - SDRVOE"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.messages?.[0]?.id }}",
